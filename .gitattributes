# Normalize line endings so the same checkout builds on Windows, macOS and Linux.
* text=auto eol=lf

# Files consumed by Linux containers must never gain CRLF, or the shell inside
# the image fails with "\r: command not found".
*.sh            text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
*.conf          text eol=lf
Dockerfile      text eol=lf
.env.example    text eol=lf

# Windows-only tooling keeps CRLF.
*.ps1           text eol=crlf
*.cmd           text eol=crlf
*.bat           text eol=crlf

# Binary assets.
*.png           binary
*.ico           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.webp          binary
