<UserControl x:Class="NexusTeam.Client.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:NexusTeam.Client.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanConverter"/>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <converters:UserStatusToBrushConverter x:Key="UserStatusToBrushConverter"/>
        <converters:UserStatusToTextConverter x:Key="UserStatusToTextConverter"/>

        <Style x:Key="SeparatorLineStyle" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource SeparatorBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style TargetType="Button" x:Key="RoundNavButtonStyle">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource NavButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource IconBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" CornerRadius="21" Background="{TemplateBinding Background}">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="5" ShadowDepth="2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource NavButtonHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CircleCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="22" Height="22" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Ellipse Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1" Fill="Transparent"/>
                                <Path x:Name="CheckMark" 
                                      Data="M 5,11 L 9,15 L 17,6" 
                                      Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" 
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CircleRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Grid Grid.Column="1" Width="22" Height="22" Margin="15,0,0,0" VerticalAlignment="Center">
                                <Ellipse Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1" Fill="Transparent"/>
                                <Ellipse x:Name="Dot" Width="12" Height="12" Fill="{DynamicResource AccentColorBrush}" Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassPanelBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource GlassPanelBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassPanelBorderBrush}"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" ShadowDepth="5" BlurRadius="20" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="{DynamicResource AppBackgroundImageSource}" Stretch="UniformToFill"/>
        </Grid.Background>

        <Border Background="{DynamicResource AppOverlayBrush}"/>

        <Grid x:Name="LayoutRoot">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="10" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Border CornerRadius="18" Background="#18FFFFFF"/>
                    <Border Style="{StaticResource GlassPanelBorderStyle}"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="10">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <!-- Folders as circular buttons -->
                            <ItemsControl ItemsSource="{Binding DataContext.ChatViewModel.Folders, RelativeSource={RelativeSource AncestorType=Window}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical" Margin="0,4" HorizontalAlignment="Center">
                                            <Button x:Name="FolderButton"
                                                    Command="{Binding DataContext.ChatViewModel.SelectFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Width="40"
                                                    Height="40"
                                                    ToolTip="{Binding Name}"
                                                    Tag="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource RoundNavButtonStyle}">
                                                        <Setter Property="Width" Value="40"/>
                                                        <Setter Property="Height" Value="40"/>
                                                        <Setter Property="Background" Value="#4E5165"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="#5B4B6F"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                
                                                <Grid>
                                                    <!-- Icon -->
                                                    <TextBlock FontFamily="Segoe MDL2 Assets" 
                                                               FontSize="18" 
                                                               Foreground="White"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAllChatsFolder}" Value="True">
                                                                        <Setter Property="Text" Value="&#xE8F2;"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsAllChatsFolder}" Value="False">
                                                                        <Setter Property="Text" Value="&#xE8B7;"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    
                                                    <!-- Unread Count Badge -->
                                                    <Border Background="#FF0078D7" 
                                                            CornerRadius="6" 
                                                            Height="12" 
                                                            MinWidth="12" 
                                                            Padding="2,0" 
                                                            VerticalAlignment="Top" 
                                                            HorizontalAlignment="Right"
                                                            Margin="0,-2,-2,0"
                                                            Visibility="{Binding UnreadCount, Converter={StaticResource CountToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding UnreadCount}" 
                                                                   Foreground="White" 
                                                                   FontSize="7" 
                                                                   FontWeight="Bold" 
                                                                   HorizontalAlignment="Center" 
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Button>
                                            
                                            <!-- Folder Name -->
                                            <TextBlock Text="{Binding Name}" 
                                                       Foreground="#CCFFFFFF" 
                                                       FontSize="9" 
                                                       HorizontalAlignment="Center"
                                                       Margin="0,0,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="50">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Foreground" Value="White"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            
                            <!-- Add Folder Button (Plus) -->
                            <StackPanel Orientation="Vertical" Margin="0,4,0,0" HorizontalAlignment="Center">
                                <Button Command="{Binding DataContext.ChatViewModel.CreateFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Width="40"
                                        Height="40"
                                        ToolTip="Create Folder">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource RoundNavButtonStyle}">
                                            <Setter Property="Width" Value="40"/>
                                            <Setter Property="Height" Value="40"/>
                                            <Setter Property="Background" Value="#4E5165"/>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="&#xE710;" 
                                               FontFamily="Segoe MDL2 Assets" 
                                               FontSize="18" 
                                               Foreground="White"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,0">
                    <Border CornerRadius="25" Background="#18FFFFFF"/>
                    <Border Style="{StaticResource GlassPanelBorderStyle}" CornerRadius="25"/>

                    <StackPanel VerticalAlignment="Center" Margin="0,15,0,15" HorizontalAlignment="Center">
                        <Button Command="{Binding DataContext.ChatViewModel.NavigateToGeneratorCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource RoundNavButtonStyle}" Background="#5B4B6F" ToolTip="Gallery">
                            <TextBlock Text="&#xE91B;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        
                        <Button Command="{Binding DataContext.ChatViewModel.NavigateToSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource RoundNavButtonStyle}" Background="{DynamicResource AccentColorBrush}" ToolTip="Settings">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Grid.Column="1" Margin="0,15,15,15">
                <Border Width="650" Style="{StaticResource GlassPanelBorderStyle}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> 
                                <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> 
                                <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> 
                                <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> 
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="35,25">
                                <Button Command="{Binding NavigateToChatCommand}" 
                                        Style="{StaticResource RoundNavButtonStyle}" 
                                        Width="36" Height="36" 
                                        HorizontalAlignment="Left" 
                                        ToolTip="Back to Chat">
                                    <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                                </Button>
                                <TextBlock Text="Settings" FontSize="28" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Light" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>

                            <Border Grid.Row="1" Style="{StaticResource SeparatorLineStyle}"/>

                            <Grid Grid.Row="2" Margin="35,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Build: 2025-05-20" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11"/>
                                <TextBlock Grid.Column="1" Text="Version: 1.0.0-beta.1" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Privacy &amp; Security" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right" Cursor="Hand" TextDecorations="Underline"/>
                            </Grid>

                            <Border Grid.Row="3" Style="{StaticResource SeparatorLineStyle}"/>

                            <StackPanel Grid.Row="4" Margin="0,30">
                                <Grid Width="110" Height="110">
                                    <!-- Avatar Image -->
                                    <Ellipse>
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding AvatarImage}" Stretch="UniformToFill"/>
                                        </Ellipse.Fill>
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="#EEDC9A" BlurRadius="30" Opacity="0.4" ShadowDepth="0"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    
                                    <!-- Click to view avatar -->
                                    <Ellipse Fill="Transparent" Cursor="Hand" MouseLeftButtonDown="AvatarEllipse_MouseLeftButtonDown"/>
                                    
                                    <!-- Edit button (pencil icon in small circle) -->
                                    <Grid Width="32" Height="32" 
                                          HorizontalAlignment="Right" 
                                          VerticalAlignment="Bottom" 
                                          Margin="0,0,-5,-5"
                                          Cursor="Hand"
                                          MouseLeftButtonDown="EditAvatarButton_MouseLeftButtonDown">
                                        <Ellipse Fill="{DynamicResource NavButtonBackgroundBrush}">
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="5" ShadowDepth="2"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <TextBlock Text="&#xE70F;" 
                                                   FontFamily="Segoe MDL2 Assets" 
                                                   FontSize="14" 
                                                   Foreground="{DynamicResource IconBrush}" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                                
                                <Grid Margin="0,20,0,0" HorizontalAlignment="Center">
                                    <!-- Display Mode -->
                                    <Border Background="{DynamicResource NavButtonBackgroundBrush}" CornerRadius="18" Padding="20,8" Cursor="Hand" Visibility="{Binding IsEditingDisplayName, Converter={StaticResource InverseBooleanConverter}}">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding StartEditingDisplayNameCommand}"/>
                                        </Border.InputBindings>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold"/>
                                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource IconBrush}" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Edit Mode -->
                                    <Border Background="{DynamicResource NavButtonBackgroundBrush}" CornerRadius="18" Padding="5,5" Visibility="{Binding IsEditingDisplayName, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Text="{Binding EditableDisplayName, UpdateSourceTrigger=PropertyChanged}" 
                                                     FontSize="15" FontWeight="SemiBold"
                                                     Background="Transparent" BorderThickness="0"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     CaretBrush="{DynamicResource TextPrimaryBrush}"
                                                     Padding="10,3" MinWidth="150">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter" Command="{Binding SaveDisplayNameCommand}"/>
                                                    <KeyBinding Key="Esc" Command="{Binding CancelEditingDisplayNameCommand}"/>
                                                </TextBox.InputBindings>
                                            </TextBox>
                                            <Button Command="{Binding SaveDisplayNameCommand}" Background="Transparent" BorderThickness="0" Margin="0,0,5,0" Cursor="Hand" ToolTip="Save">
                                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentColorBrush}" FontSize="14"/>
                                            </Button>
                                            <Button Command="{Binding CancelEditingDisplayNameCommand}" Background="Transparent" BorderThickness="0" Margin="0,0,5,0" Cursor="Hand" ToolTip="Cancel">
                                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource ErrorColorBrush}" FontSize="14"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Clickable status under title: Online / Invisible dropdown -->
                                <Grid Margin="0,12,0,0" HorizontalAlignment="Center">
                                    <Border x:Name="StatusPill"
                                            Background="#28FFFFFF"
                                            BorderBrush="#50FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="16"
                                            Padding="14,7"
                                            Cursor="Hand"
                                            ToolTip="Click to change status">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleStatusDropdownCommand}"/>
                                        </Border.InputBindings>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="14" Height="14"
                                                     Fill="{Binding MyStatus, Converter={StaticResource UserStatusToBrushConverter}}"
                                                     Stroke="#FFFFFF"
                                                     StrokeThickness="2"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,10,0">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect BlurRadius="8" Opacity="0.9" ShadowDepth="0" Color="#22C55E"/>
                                                </Ellipse.Effect>
                                            </Ellipse>
                                            <TextBlock Text="{Binding StatusLabel}"
                                                       Foreground="{Binding MyStatus, Converter={StaticResource UserStatusToBrushConverter}}"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="&#xE70D;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       FontSize="10"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <Popup IsOpen="{Binding IsStatusDropdownOpen, Mode=TwoWay}"
                                           PlacementTarget="{Binding ElementName=StatusPill}"
                                           Placement="Bottom"
                                           StaysOpen="False"
                                           AllowsTransparency="True"
                                           HorizontalOffset="0"
                                           VerticalOffset="6">
                                        <Border Background="#E8252535"
                                                BorderBrush="#40FFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="6"
                                                MinWidth="170">
                                            <Border.Effect>
                                                <DropShadowEffect ShadowDepth="4" BlurRadius="12" Opacity="0.45" Direction="270"/>
                                            </Border.Effect>
                                            <StackPanel>
                                                <Button Command="{Binding SetOnlineStatusCommand}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        HorizontalContentAlignment="Left"
                                                        Padding="10,8"
                                                        Margin="0,0,0,2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="10" Height="10" Fill="#22C55E" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Online" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#30FFFFFF"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <Button Command="{Binding SetInvisibleStatusCommand}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        HorizontalContentAlignment="Left"
                                                        Padding="10,8">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="10" Height="10" Fill="#808080" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Invisible" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#30FFFFFF"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </StackPanel>

                            <Border Grid.Row="5" Style="{StaticResource SeparatorLineStyle}"/>

                            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15">
                                <TextBlock Text="{Binding UserEmail, StringFormat='Email: {0}'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"/>
                                <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,2,20,0" VerticalAlignment="Center" Cursor="Hand" FontSize="14">
                                    <TextBlock.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding CopyEmailCommand}"/>
                                    </TextBlock.InputBindings>
                                </TextBlock>
                                
                                <TextBlock Text="{Binding Username, StringFormat='Username: {0}'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"/>
                                <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,2,0,0" VerticalAlignment="Center" Cursor="Hand" FontSize="14">
                                    <TextBlock.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding CopyUsernameCommand}"/>
                                    </TextBlock.InputBindings>
                                </TextBlock>
                            </StackPanel>

                            <Border Grid.Row="7" Style="{StaticResource SeparatorLineStyle}"/>

                            <Grid Grid.Row="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/> 
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="35,20">
                                    <TextBlock Text="Notifications" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,15" FontSize="14"/>
                                    <CheckBox Content="Message notifications" Style="{StaticResource CircleCheckBoxStyle}"/>
                                    <CheckBox Content="Sound enabled" IsChecked="True" Style="{StaticResource CircleCheckBoxStyle}"/>
                                    <CheckBox Content="Show preview" Style="{StaticResource CircleCheckBoxStyle}"/>
                                </StackPanel>

                                <Border Grid.Column="1" Background="{DynamicResource SeparatorBrush}" VerticalAlignment="Stretch"/>

                                <StackPanel Grid.Column="2" Margin="35,20">
                                    <TextBlock Text="Language" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,15" FontSize="14"/>
                                    <RadioButton GroupName="Lang" Content="Ukrainian" Style="{StaticResource CircleRadioButtonStyle}"/>
                                    <RadioButton GroupName="Lang" Content="Deutsch" Style="{StaticResource CircleRadioButtonStyle}"/>
                                    <RadioButton GroupName="Lang" Content="English" IsChecked="True" Style="{StaticResource CircleRadioButtonStyle}"/>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="9" Style="{StaticResource SeparatorLineStyle}"/>

                            <StackPanel Grid.Row="10" Margin="35,20">
                                <TextBlock Text="Privacy &amp; Security" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,15" FontSize="14"/>
                                <TextBlock Text="Change Online / Invisible under your name above."
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="0,0,0,12"/>
                                <CheckBox Content="Allow others to find me" IsChecked="True" Style="{StaticResource CircleCheckBoxStyle}" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <Border Grid.Row="11" Style="{StaticResource SeparatorLineStyle}"/>

                            <Button Grid.Row="12" Command="{Binding LogoutCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,25">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource ErrorColorBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="L O G O U T" Foreground="{DynamicResource ErrorColorBrush}" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.7"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
