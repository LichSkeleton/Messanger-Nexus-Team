<UserControl x:Class="NexusTeam.Client.Views.GeneratorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:converters="clr-namespace:NexusTeam.Client.Converters"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="1000">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:BooleanToBackgroundConverter x:Key="BooleanToBackgroundConverter"/>
        <converters:PromptPreviewConverter x:Key="PromptPreviewConverter"/>
        
        <Style TargetType="Button" x:Key="GlassActionButtonStyle">
             <Setter Property="Background" Value="#25FFFFFF"/>
             <Setter Property="Foreground" Value="White"/>
             <Setter Property="BorderThickness" Value="0"/>
             <Setter Property="Width" Value="30"/>
             <Setter Property="Height" Value="30"/>
             <Setter Property="Cursor" Value="Hand"/>
             <Setter Property="Template">
                 <Setter.Value>
                     <ControlTemplate TargetType="Button">
                         <Border Background="{TemplateBinding Background}" CornerRadius="15">
                             <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                         </Border>
                         <ControlTemplate.Triggers>
                             <Trigger Property="IsMouseOver" Value="True">
                                 <Setter Property="Background" Value="#40FFFFFF"/>
                             </Trigger>
                         </ControlTemplate.Triggers>
                     </ControlTemplate>
                 </Setter.Value>
             </Setter>
        </Style>

        <Style x:Key="GlassPanelBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="#000000" Opacity="0.05"/>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#60FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                        <GradientStop Color="#20FFFFFF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Bd" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#35FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="RoundNavButtonStyle">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#33354E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" CornerRadius="20"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Direction="315" ShadowDepth="2" BlurRadius="4" Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#4E517A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2A2C40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PromptTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost"/>
                            
                            <TextBlock x:Name="PlaceholderText"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="#50FFFFFF"
                                       FontStyle="Italic"
                                       IsHitTestVisible="False"
                                       Margin="2,0,0,0"
                                       Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentColorBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeleteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#90202020"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DD4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModelDropdownItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="{DynamicResource AppBackgroundImageSource}" Stretch="UniformToFill"/>
        </Grid.Background>
        
        <Border Background="{DynamicResource AppOverlayBrush}"/>

        <Grid x:Name="MainContentGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left sidebar -->
            <Grid Grid.Column="0" Margin="10" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Border CornerRadius="18" Background="#18FFFFFF"/>
                    <Border Style="{StaticResource GlassPanelBorderStyle}"/>

                    <!-- Model Selection -->
                    <StackPanel Margin="0,10,0,10" HorizontalAlignment="Center">
                        <TextBlock Text="MODEL" FontSize="9" Foreground="#80FFFFFF" HorizontalAlignment="Center" Margin="0,5,0,5"/>
                        
                        <Button x:Name="ModelDropdownButton"
                                Style="{StaticResource RoundNavButtonStyle}" 
                                Command="{Binding ToggleModelDropdownCommand}"
                                ToolTip="{Binding SelectedModelName}">
                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        
                        <TextBlock Text="{Binding SelectedModelName}" FontSize="9" Foreground="#AAAAAA" 
                                   HorizontalAlignment="Center" Margin="0,5,0,0" FontWeight="SemiBold"/>

                        <!-- Model Dropdown Popup -->
                        <Popup IsOpen="{Binding IsModelDropdownOpen, Mode=TwoWay}" 
                               PlacementTarget="{Binding ElementName=ModelDropdownButton}" 
                               Placement="Right" HorizontalOffset="10" StaysOpen="False"
                               AllowsTransparency="True">
                            <Border Background="#252545" CornerRadius="8" Padding="5" MinWidth="150">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="10" Opacity="0.5"/>
                                </Border.Effect>
                                <ItemsControl ItemsSource="{Binding AvailableModels}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ModelDropdownItemStyle}"
                                                    Command="{Binding DataContext.SelectModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Id}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="White"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#80FFFFFF"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,0">
                    <Border CornerRadius="25" Background="#18FFFFFF"/>
                    <Border Style="{StaticResource GlassPanelBorderStyle}" CornerRadius="25"/>

                    <StackPanel VerticalAlignment="Center" Margin="0,15,0,15" HorizontalAlignment="Center">
                        
                        <Button Style="{StaticResource RoundNavButtonStyle}" Background="#6E7195" ToolTip="Gallery">
                            <TextBlock Text="&#xE91B;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        
                        <Button Command="{Binding DataContext.NavigateToSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Style="{StaticResource RoundNavButtonStyle}" 
                                Background="#33354E" 
                                ToolTip="Settings">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Main content -->
            <Grid Grid.Column="1" Margin="20,10,20,10">
                <Border CornerRadius="18" Background="#18FFFFFF"/>
                <Border Style="{StaticResource GlassPanelBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="60"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="200"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" 
                                    Command="{Binding NavigateBackCommand}" 
                                    Style="{StaticResource RoundNavButtonStyle}" 
                                    Width="36" Height="36" 
                                    HorizontalAlignment="Left"
                                    Margin="10,0,0,0" 
                                    Background="#33354E" 
                                    ToolTip="Back">
                                <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                            </Button>
                            
                            <TextBlock Grid.Column="1" Text="AI Image Generator" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <!-- Model indicator -->
                            <Border Grid.Column="2" Background="#25FFFFFF" CornerRadius="12" Padding="10,5" Margin="0,0,15,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedModelName}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            </Border>
                        </Grid>
                        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="#20FFFFFF"/>

                        <!-- Info row -->
                        <Grid Grid.Row="1" Margin="25,0">
                            <TextBlock Text="Pollinations AI (Free)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock Text="⏱ Rate limit: 1 request / 15 sec" Foreground="#FF9800" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Free tier allows 1 image generation every 15 seconds"/>
                            <TextBlock Text="1024 x 1024 px" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Grid.Row="1" VerticalAlignment="Bottom" Height="1" Background="#20FFFFFF"/>

                        <!-- Prompt input -->
                        <Grid Grid.Row="2" Margin="25,15">
                            <TextBox Style="{StaticResource PromptTextBoxStyle}" 
                                     Text="{Binding PromptText, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Describe the image you want to generate..." 
                                     VerticalAlignment="Top" Height="150"
                                     MaxLength="500"/>
                            
                            <TextBlock Text="{Binding CharacterCount, StringFormat='{}{0}/500 characters'}" 
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" 
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        </Grid>
                        <Border Grid.Row="2" VerticalAlignment="Bottom" Height="1" Background="#20FFFFFF"/>

                        <!-- Action buttons -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="SAVE INTO" Style="{StaticResource ActionButtonStyle}"
                                    Command="{Binding SaveImageCommand}"
                                    IsEnabled="{Binding HasCurrentImage}"/>

                            <Border Grid.Column="1" Background="#20FFFFFF" Margin="0,10"/>

                            <Button Grid.Column="2" Content="SEND TO" Style="{StaticResource ActionButtonStyle}"
                                    Command="{Binding OpenSendToDialogCommand}"
                                    IsEnabled="{Binding HasCurrentImage}"/>
                        </Grid>
                        <Border Grid.Row="3" VerticalAlignment="Bottom" Height="1" Background="#20FFFFFF"/>

                        <!-- Generated image display -->
                        <Grid Grid.Row="4" Margin="25,15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Time ago header -->
                            <TextBlock Grid.Row="0" 
                                       Text="{Binding GeneratedTimeAgo, StringFormat='Generated {0}'}" 
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10"
                                       Visibility="{Binding HasCurrentImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            
                            <!-- Image container -->
                            <Grid Grid.Row="1">
                                <!-- No image placeholder -->
                                <Border Background="#252545" CornerRadius="8" 
                                        Visibility="{Binding HasCurrentImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="48" Foreground="#40FFFFFF" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Generated image will appear here" Foreground="#60FFFFFF" FontSize="12" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Loading indicator -->
                                <Border Background="#252545" CornerRadius="8" 
                                        Visibility="{Binding IsGenerating, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="48" Foreground="#80FFFFFF" HorizontalAlignment="Center">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform x:Name="LoadingRotate" Angle="0"/>
                                            </TextBlock.RenderTransform>
                                            <TextBlock.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetName="LoadingRotate"
                                                                           Storyboard.TargetProperty="Angle"
                                                                           From="0" To="360" Duration="0:0:2"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </TextBlock.Triggers>
                                        </TextBlock>
                                        <TextBlock Text="{Binding GenerationStatus, FallbackValue='Generating image...'}" 
                                                   Foreground="#80FFFFFF" FontSize="12" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Flux: ~30-60s, Turbo: ~10-20s" Foreground="#50FFFFFF" FontSize="10" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Generated image -->
                                <Border CornerRadius="8" HorizontalAlignment="Left" 
                                        Visibility="{Binding HasCurrentImage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        MaxWidth="300" MaxHeight="200">
                                    <Grid>
                                        <Border Background="#252545" CornerRadius="8">
                                            <Image Source="{Binding CurrentImage}" Stretch="Uniform" Cursor="Hand">
                                                <Image.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding ViewImageCommand}"/>
                                                </Image.InputBindings>
                                            </Image>
                                        </Border>

                                        <!-- Delete button overlay -->
                                        <Button Style="{StaticResource DeleteButtonStyle}"
                                                Command="{Binding DeleteImageCommand}"
                                                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="5"
                                                ToolTip="Delete image">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="White" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                        
                        <Border Grid.Row="5" VerticalAlignment="Top" Height="1" Background="#20FFFFFF"/>

                        <!-- Recent prompts -->
                        <Grid Grid.Row="5" Margin="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Button Grid.Column="0" Style="{StaticResource GlassActionButtonStyle}" Width="40" Height="40"
                                    Command="{Binding TogglePromptsDropdownCommand}" ToolTip="Recent prompts">
                                <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="White" 
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Button>
                            
                            <Border Grid.Column="0" HorizontalAlignment="Right" Width="1" Background="#30FFFFFF" Margin="0,10"/>

                            <!-- Recent prompts list (hidden - only visible in dropdown) -->
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding RecentPrompts}" Margin="15,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="0,0,10,0"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" 
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="WordEllipsis" 
                                                   MaxWidth="150"
                                                   TextWrapping="NoWrap"
                                                   VerticalAlignment="Center"
                                                   LineHeight="14"
                                                   LineStackingStrategy="BlockLineHeight"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Prompts Dropdown Popup -->
                            <Popup Grid.Column="0" IsOpen="{Binding IsPromptsDropdownOpen}" 
                                   Placement="Top" VerticalOffset="-5" StaysOpen="False">
                                <Border Background="#1A1A2E" 
                                        BorderBrush="#40FFFFFF" 
                                        BorderThickness="1"
                                        CornerRadius="8" 
                                        Padding="8" 
                                        MinWidth="260"
                                        MaxWidth="420" 
                                        MaxHeight="420">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Direction="315" ShadowDepth="3" BlurRadius="10" Opacity="0.6"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0" Height="360">
                                        <ScrollViewer.Resources>
                                            <!-- Custom ScrollBar Style - Same as EmojiPicker -->
                                            <Style TargetType="ScrollBar">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Width" Value="3"/>
                                                <Setter Property="MinWidth" Value="3"/>
                                                <Setter Property="MaxWidth" Value="3"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ScrollBar">
                                                            <Grid>
                                                                <Border x:Name="Track" 
                                                                        Background="#1A1A2E" 
                                                                        CornerRadius="4"
                                                                        Opacity="0.4"
                                                                        Margin="0,0">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Width" Value="3"/>
                                                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                                                        </Style>
                                                                    </Border.Style>
                                                                </Border>
                                                                <Track x:Name="PART_Track" 
                                                                       IsDirectionReversed="True"
                                                                       Focusable="False">
                                                                    <Track.Thumb>
                                                                        <Thumb>
                                                                            <Thumb.Template>
                                                                                <ControlTemplate TargetType="Thumb">
                                                                                    <Border x:Name="ThumbBorder"
                                                                                            Background="#8A8AAA"
                                                                                            CornerRadius="4"
                                                                                            Opacity="1"
                                                                                            Margin="0,0"
                                                                                            UseLayoutRounding="True"
                                                                                            SnapsToDevicePixels="True">
                                                                                        <Border.Style>
                                                                                            <Style TargetType="Border">
                                                                                                <Style.Triggers>
                                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                                        <Setter Property="Background" Value="#AAAAAA"/>
                                                                                                        <Setter Property="Opacity" Value="1"/>
                                                                                                    </Trigger>
                                                                                                    <DataTrigger Binding="{Binding IsDragging, RelativeSource={RelativeSource AncestorType=Thumb}}" Value="True">
                                                                                                        <Setter Property="Background" Value="#BABABA"/>
                                                                                                        <Setter Property="Opacity" Value="1"/>
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </Border.Style>
                                                                                    </Border>
                                                                                </ControlTemplate>
                                                                            </Thumb.Template>
                                                                        </Thumb>
                                                                    </Track.Thumb>
                                                                </Track>
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ScrollViewer.Resources>
                                        <ItemsControl ItemsSource="{Binding RecentPrompts}"
                                                      HorizontalContentAlignment="Stretch">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Vertical"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Margin" Value="0"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.SelectPromptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent"
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            HorizontalContentAlignment="Stretch"
                                                            Padding="12,10"
                                                            MinWidth="0"
                                                            Height="32"
                                                            Margin="0"
                                                            Cursor="Hand"
                                                            ToolTip="{Binding}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Stretch"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="border" Property="Background" Value="#40FFFFFF"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <TextBlock Text="{Binding}" 
                                                                   TextWrapping="NoWrap" 
                                                                   TextTrimming="WordEllipsis"
                                                                   FontSize="11"
                                                                   VerticalAlignment="Center"
                                                                   Margin="2,0"/>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        
                        <Border Grid.Row="6" VerticalAlignment="Top" Height="1" Background="#20FFFFFF"/>

                        <!-- Generate button -->
                        <Button Grid.Row="6" Command="{Binding GenerateCommand}"
                                Background="Transparent" Foreground="#CCCCCC"
                                BorderThickness="0" Cursor="Hand" FontSize="12" FontWeight="SemiBold">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock x:Name="icon" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0"/>
                                                        <TextBlock x:Name="text" Text="{Binding CooldownText}"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="text" Property="Foreground" Value="White"/>
                                                        <Setter TargetName="icon" Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="text" Property="Foreground" Value="#FF9800"/>
                                                        <Setter TargetName="icon" Property="Opacity" Value="0.5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Send to Chat Dialog Overlay -->
        <Grid Visibility="{Binding IsSendToChatDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="{DynamicResource ProfileOverlayBrush}" MouseDown="DialogOverlay_MouseDown"/>
            
            <Border Width="420"
                    Height="520"
                    Padding="20"
                    CornerRadius="20"
                    Background="#F0202030"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#60FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                        <GradientStop Color="#20FFFFFF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.BorderThickness>
                    <Thickness>1</Thickness>
                </Border.BorderThickness>
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Direction="315" ShadowDepth="5" BlurRadius="15" Opacity="0.5"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="60"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0">
                        <TextBlock Text="Send to Chat" FontSize="16" FontWeight="SemiBold" Foreground="White"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Button Style="{StaticResource GlassActionButtonStyle}" Width="30" Height="30"
                                Command="{Binding CloseSendToDialogCommand}"
                                HorizontalAlignment="Right" Margin="10,0">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="White"/>
                        </Button>
                    </Grid>
                    <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="#30FFFFFF"/>

                    <!-- Chat list -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10">
                        <ItemsControl ItemsSource="{Binding Conversations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding IsSelected, Converter={StaticResource BooleanToBackgroundConverter}}"
                                            CornerRadius="10" Margin="0,4" Cursor="Hand"
                                            MouseDown="ChatItem_MouseDown">
                                        <Grid Margin="10,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="White" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Grid Grid.Row="2" Margin="10">
                        <Button Content="SEND" Command="{Binding SendToChatsCommand}"
                                Background="Transparent" Foreground="White" FontWeight="SemiBold"
                                HorizontalAlignment="Stretch" Height="40" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border"
                                            Background="Transparent"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#80FFFFFF" Offset="0.0"/>
                                                <GradientStop Color="#40FFFFFF" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#20FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#30FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
