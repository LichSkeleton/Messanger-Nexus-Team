<Window x:Class="NexusTeam.Client.Views.EditGroupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:NexusTeam.Client.Converters"
        Title="Edit Group"
        Height="360" Width="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </Window.Resources>

    <Border Background="#E8252535" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="14" Padding="24">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="6" BlurRadius="20" Opacity="0.45" Direction="270"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Edit Group" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,16">
                <Button Command="{Binding BrowseAvatarCommand}"
                        Width="72" Height="72"
                        Cursor="Hand"
                        ToolTip="Change group avatar"
                        Background="Transparent"
                        BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse Width="72" Height="72" Fill="#33354E"/>
                                <Ellipse Width="72" Height="72">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding DataContext.AvatarPreview, RelativeSource={RelativeSource AncestorType=Window}}" Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Border Background="#66000000" CornerRadius="36" Width="72" Height="72">
                                    <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets"
                                               Foreground="White" FontSize="18"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock Text="Change avatar" Foreground="#AAFFFFFF" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="2">
                <TextBlock Text="Group name" Foreground="#CCFFFFFF" FontSize="12" Margin="0,0,0,6"/>
                <Border Background="#25FFFFFF" CornerRadius="6">
                    <TextBox Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" Foreground="White" CaretBrush="White"
                             BorderThickness="0" Padding="10,8" FontSize="14"/>
                </Border>
            </StackPanel>

            <TextBlock Grid.Row="3" Text="{Binding ValidationError}" Foreground="#FF6B6B"
                       FontSize="12" Margin="0,8,0,0"
                       Visibility="{Binding ValidationError, Converter={StaticResource StringToVisibilityConverter}}"/>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" Click="OnCancelClick" Padding="18,8" Margin="0,0,10,0"
                        Background="#25FFFFFF" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <Button Content="Save" Click="OnSaveClick" Padding="18,8"
                        Background="#5B4B6F" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
