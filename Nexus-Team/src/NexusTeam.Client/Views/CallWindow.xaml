<Window x:Class="NexusTeam.Client.Views.CallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:NexusTeam.Client.Converters"
        Title="Voice Call"
        Height="550" Width="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        
        <Style TargetType="Button" x:Key="RoundNavButtonStyle">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="70"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#33354E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                CornerRadius="35"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Direction="315" ShadowDepth="3" BlurRadius="8" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#4E517A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2A2C40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="AnswerButtonStyle" BasedOn="{StaticResource RoundNavButtonStyle}">
            <Setter Property="Background" Value="#4CAF50"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#66BB6A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="RejectButtonStyle" BasedOn="{StaticResource RoundNavButtonStyle}">
            <Setter Property="Background" Value="#F44336"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EF5350"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="EndCallButtonStyle" BasedOn="{StaticResource RoundNavButtonStyle}">
            <Setter Property="Background" Value="#F44336"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EF5350"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Width="400"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Padding="40"
                CornerRadius="25"
                Background="#F0202030">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#60FFFFFF" Offset="0.0"/>
                    <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                    <GradientStop Color="#20FFFFFF" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.BorderThickness>
                <Thickness>1</Thickness>
            </Border.BorderThickness>
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="315" ShadowDepth="8" BlurRadius="20" Opacity="0.6"/>
            </Border.Effect>
            
            <StackPanel>
                <!-- Caller Avatar and Info -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,30">
                    <!-- Avatar -->
                    <Grid Width="120" Height="120" Margin="0,0,0,20">
                        <Ellipse Fill="#33354E">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="10" Opacity="0.5" ShadowDepth="3"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Image Source="{Binding CallerAvatar}" 
                               Stretch="UniformToFill"
                               Visibility="{Binding CallerAvatar, Converter={StaticResource NullToVisibilityConverter}}">
                            <Image.Clip>
                                <EllipseGeometry Center="60,60" RadiusX="60" RadiusY="60"/>
                            </Image.Clip>
                        </Image>
                        <!-- Fallback: First letter of name -->
                        <TextBlock Text="{Binding CallerName, Converter={StaticResource FirstCharacterConverter}}" 
                                  Foreground="White" 
                                  FontSize="48" 
                                  FontWeight="Bold"
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"
                                  Visibility="{Binding CallerAvatar, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                    </Grid>
                    
                    <!-- Caller Name -->
                    <TextBlock Text="{Binding CallerName, FallbackValue='Unknown User'}" 
                              Foreground="White" 
                              FontSize="26" 
                              FontWeight="SemiBold" 
                              HorizontalAlignment="Center"
                              Margin="0,0,0,8"/>

                    <!-- Call Duration -->
                    <TextBlock Text="{Binding CallDurationText}" 
                              Foreground="White" 
                              FontSize="18" 
                              FontWeight="SemiBold" 
                              HorizontalAlignment="Center"
                              Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Margin="0,0,0,8"/>
                    
                    <!-- Call Direction Text -->
                    <TextBlock HorizontalAlignment="Center" Margin="0,0,0,5">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#B0FFFFFF"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsIncomingCall}" Value="True">
                                        <Setter Property="Text" Value="Incoming call"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsIncomingCall}" Value="False">
                                        <Setter Property="Text" Value="Outgoing call"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    
                    <!-- Call State Text -->
                    <TextBlock HorizontalAlignment="Center" Margin="0,0,0,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#B0FFFFFF"/>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                                <Style.Triggers>
                                    <!-- Connected has highest priority; also when duration started -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsConnected}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Text" Value="Connected"/>
                                        <Setter Property="Foreground" Value="#4CAF50"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasCallDuration}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Text" Value="Connected"/>
                                        <Setter Property="Foreground" Value="#4CAF50"/>
                                    </MultiDataTrigger>
                                    <!-- Ringing (incoming) -->
                                    <DataTrigger Binding="{Binding IsRinging}" Value="True">
                                        <Setter Property="Text" Value="Ringing..."/>
                                        <Setter Property="Foreground" Value="#FFD700"/>
                                    </DataTrigger>
                                    <!-- Connecting -->
                                    <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                        <Setter Property="Text" Value="Connecting..."/>
                                        <Setter Property="Foreground" Value="#42A5F5"/>
                                    </DataTrigger>
                                    <!-- Outgoing dialing (only when not yet connected / no duration) -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsOutgoingCall}" Value="True"/>
                                            <Condition Binding="{Binding IsConnected}" Value="False"/>
                                            <Condition Binding="{Binding HasCallDuration}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Text" Value="Calling..."/>
                                        <Setter Property="Foreground" Value="#42A5F5"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Action Buttons -->
                <Grid Margin="0,20,0,0">
                    <!-- For incoming calls: Show Answer and Reject buttons side by side -->
                    <StackPanel Orientation="Horizontal" 
                               HorizontalAlignment="Center"
                               Visibility="{Binding CanAnswer, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Command="{Binding AnswerCallCommand}"
                               Style="{StaticResource AnswerButtonStyle}"
                               Margin="0,0,20,0"
                               ToolTip="Answer Call">
                            <TextBlock Text="&#xE717;" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="White"/>
                        </Button>
                        <Button Command="{Binding RejectCallCommand}"
                               Style="{StaticResource RejectButtonStyle}"
                               ToolTip="Reject Call">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="White"/>
                        </Button>
                    </StackPanel>

                    <!-- For active calls: Show End Call button -->
                    <Button HorizontalAlignment="Center"
                           Command="{Binding EndCallCommand}"
                           Visibility="{Binding CanEnd, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Style="{StaticResource EndCallButtonStyle}"
                           ToolTip="End Call">
                        <TextBlock Text="&#xE778;" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="White"/>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
