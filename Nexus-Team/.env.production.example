# Copy this file to .env.production and replace every CHANGE_ME value.
# .env.production is ignored by Git and is uploaded to the server by deploy.sh.

# The application containers bind locally; the production gateway owns 80/443.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
SERVICE_BIND_ADDRESS=127.0.0.1
PUBLIC_IP=CHANGE_ME_PUBLIC_IPV4
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
# Optional but recommended for Let's Encrypt account notices.
LETSENCRYPT_EMAIL=
SERVER_PORT=5251
ORACLE_PORT=1530
REDIS_PORT=6380
MONGO_PORT=27018

ORACLE_SERVICE=FREEPDB1
ORACLE_APP_USER=nexusteam_admin
ORACLE_APP_PASSWORD=CHANGE_ME_ORACLE_APP_PASSWORD
ORACLE_SYS_PASSWORD=CHANGE_ME_ORACLE_SYS_PASSWORD

MONGO_DATABASE=NexusTeam

# Generate each value independently, for example: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
DEVICE_LOCK_PIN_PEPPER=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
TURN_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
